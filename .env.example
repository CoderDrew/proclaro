# Copy to .env.local. For local development, `npx supabase status` prints the real URL and keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Origin of this app, used for the invite link redirect. Must match an entry in supabase/config.toml.
SITE_URL=http://127.0.0.1:3000
