# Copy to .env.local. For local development, `npx supabase status` prints the real URL and keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Origin of this app, used for the invite link redirect. Must match an entry in supabase/config.toml.
SITE_URL=http://127.0.0.1:3000
# DEV_EMAIL_LOGIN=1  # local only: sign in by email without a password
# Hosted site only (README "Hosting"): list the demo accounts on the sign-in page, and close signup.
# DEMO_PASSWORD=
# SIGNUP_CLOSED=1
