// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`addendum PDF > matches the snapshot 1`] = `
"<!doctype html><html lang="en"><head><meta charSet="utf-8"/><title>Addendum 1 to Solicitation 27-0001</title><style>
@page { size: letter; margin: 0.9in 0.8in 1in 0.8in; }
* { box-sizing: border-box; }
body { font-family: Georgia, "Times New Roman", serif; font-size: 11pt; line-height: 1.4; color: #111; margin: 0; }
h1 { font-size: 22pt; margin: 0 0 12pt; }
h2 { font-size: 15pt; margin: 0 0 8pt; border-bottom: 1px solid #444; padding-bottom: 3pt; }
h3 { font-size: 12pt; margin: 12pt 0 4pt; }
p { margin: 0 0 8pt; }
table { border-collapse: collapse; width: 100%; margin: 6pt 0 12pt; }
th, td { border: 1px solid #555; padding: 4pt 6pt; text-align: left; vertical-align: top; }
th { background: #eee; }
.major { page-break-before: always; }
.cover { text-align: center; padding-top: 1.5in; }
.cover .meta { margin-top: 24pt; }
.toc li { margin: 3pt 0; }
.watermark { position: fixed; top: 38%; left: 0; width: 100%; text-align: center; font-size: 54pt; font-weight: bold;
  color: rgba(180, 0, 0, 0.14); transform: rotate(-30deg); pointer-events: none; z-index: 10; }
.bid-page { page-break-before: always; page-break-inside: avoid; position: relative; min-height: 8.6in; }
.bid-page:first-of-type { page-break-before: auto; }
.bid-page footer { position: absolute; bottom: 0; left: 0; right: 0; border-top: 1px solid #555; padding-top: 4pt;
  font-size: 9pt; text-align: center; }
/* The PDF step prints the real page numbers in Chromium's footer; hide the in-body copy. */
@media print { .bid-page footer { display: none; } }
.write-in { display: inline-block; min-width: 2.5in; border-bottom: 1px solid #111; height: 1em; }
.sig-line { margin-top: 28pt; border-bottom: 1px solid #111; width: 70%; }
.price { text-align: right; width: 2in; }
.muted { color: #555; }
</style></head><body><h1>Addendum 1</h1><table data-addendum-meta="true"><tbody><tr><th>Solicitation</th><td>27-0001</td></tr><tr><th>Title</th><td>Dormitory Roof Repair</td></tr><tr><th>Version</th><td>Version 2</td></tr><tr><th>Published</th><td>June 10, 2027</td></tr></tbody></table><section data-addendum-narrative="true"><h2>Changes in this addendum</h2><p>Adds a third dormitory.</p><p>Moves the bid due date one week later.</p></section><section data-addendum-schedule="true"><h2>Bid schedule changes</h2><ul><li>Item 3 added: Dormitory C: Roof</li><li>Alternate 1 changed from &quot;Additive: Add gutters&quot; to &quot;Additive: Add &lt;gutters&gt; &amp; downspouts&quot;</li></ul></section><section data-addendum-dates="true"><h2>Key date changes</h2><table><thead><tr><th>Date</th><th>Was</th><th>Now</th></tr></thead><tbody><tr><td>Bids due</td><td>July 1, 2027, 1:00 PM MDT</td><td>July 8, 2027, 1:00 PM MDT</td></tr></tbody></table></section><section data-addendum-answers="true"><h2>Questions and answers</h2><div data-answer="true"><h3>Question 1</h3><p>Is the roof membrane specified?</p><p><strong>Answer</strong></p><p>Yes, see section 07 54 00.</p></div></section><footer hidden="" data-footer="final" data-footer-template="Solicitation 27-0001 · Version 2 · Page {n} of {total}"></footer></body></html>"
`;

exports[`bid form fill > without a fill the output is unchanged from slice 1 1`] = `
"<!doctype html><html lang="en"><head><meta charSet="utf-8"/><title>Bid Form 27-0001</title><style>
@page { size: letter; margin: 0.9in 0.8in 1in 0.8in; }
* { box-sizing: border-box; }
body { font-family: Georgia, "Times New Roman", serif; font-size: 11pt; line-height: 1.4; color: #111; margin: 0; }
h1 { font-size: 22pt; margin: 0 0 12pt; }
h2 { font-size: 15pt; margin: 0 0 8pt; border-bottom: 1px solid #444; padding-bottom: 3pt; }
h3 { font-size: 12pt; margin: 12pt 0 4pt; }
p { margin: 0 0 8pt; }
table { border-collapse: collapse; width: 100%; margin: 6pt 0 12pt; }
th, td { border: 1px solid #555; padding: 4pt 6pt; text-align: left; vertical-align: top; }
th { background: #eee; }
.major { page-break-before: always; }
.cover { text-align: center; padding-top: 1.5in; }
.cover .meta { margin-top: 24pt; }
.toc li { margin: 3pt 0; }
.watermark { position: fixed; top: 38%; left: 0; width: 100%; text-align: center; font-size: 54pt; font-weight: bold;
  color: rgba(180, 0, 0, 0.14); transform: rotate(-30deg); pointer-events: none; z-index: 10; }
.bid-page { page-break-before: always; page-break-inside: avoid; position: relative; min-height: 8.6in; }
.bid-page:first-of-type { page-break-before: auto; }
.bid-page footer { position: absolute; bottom: 0; left: 0; right: 0; border-top: 1px solid #555; padding-top: 4pt;
  font-size: 9pt; text-align: center; }
/* The PDF step prints the real page numbers in Chromium's footer; hide the in-body copy. */
@media print { .bid-page footer { display: none; } }
.write-in { display: inline-block; min-width: 2.5in; border-bottom: 1px solid #111; height: 1em; }
.sig-line { margin-top: 28pt; border-bottom: 1px solid #111; width: 70%; }
.price { text-align: right; width: 2in; }
.muted { color: #555; }
</style></head><body><section data-bid-form-page="1" class="bid-page"><h2>Bid Form Instructions</h2><section data-clause="bid_form_instructions"><h3>Instructions for Completing the Bid Form</h3><p>Read this whole document before filling in the bid form. Type or print clearly in ink. Fill in every line. Enter a price for every line item, using dollars and cents. Write &quot;no change&quot; for an alternate you are not pricing at a change. Do not leave a price line blank.</p><p>If you make a mistake, draw one line through it, write the correction beside it and initial it. Do not use correction fluid. A bid with an unreadable or unclear price may be rejected.</p><p>The person signing must be authorized to bind the firm. Attach the other items the checklist lists, in the order shown, and keep within the page limits stated. Put the bid, together with any bid security, in one sealed package marked with the solicitation number and the bid due date.</p></section><h3>Items to submit</h3><ul><li>Bid Form Section 1</li><li>Bid Form Section 2</li><li>Signature Page</li><li>Proof of Insurance</li></ul><footer data-footer="final" data-footer-template="Solicitation 27-0001 · Version 1 · Page {n} of {total}">Solicitation 27-0001 · Version 1 · Page <span data-page-n="true">1</span> of <span data-page-total="true">4</span></footer></section><section data-bid-form-page="2" class="bid-page"><h2>Bid Form Section 1: Bid Prices</h2><p>Project: Dormitory Roof Repair</p><table data-bid-schedule="true"><thead><tr><th>Item</th><th>Description</th><th class="price">Lump-sum price</th></tr></thead><tbody><tr><td>Dormitory A</td><td>Roof</td><td class="price">$</td></tr><tr><td>Dormitory B</td><td></td><td class="price">$</td></tr></tbody></table><table data-bid-alternates="true"><thead><tr><th>Alternate</th><th>Description</th><th class="price">Amount to add or deduct</th></tr></thead><tbody><tr><td>Alternate 1 (add)</td><td>Add gutters</td><td class="price">$</td></tr></tbody></table><p data-alternates-order="true">The alternates above will be taken into account in the order listed, Alternate 1 first.</p><table data-bid-total="true"><tbody><tr><th>TOTAL BID (all items above, excluding alternates)</th><td class="price">$</td></tr></tbody></table><p data-bond-line="true">Bid bond for ten percent of the total bid is attached: Yes <span class="write-in"></span> No <span class="write-in"></span></p><footer data-footer="final" data-footer-template="Solicitation 27-0001 · Version 1 · Page {n} of {total}">Solicitation 27-0001 · Version 1 · Page <span data-page-n="true">2</span> of <span data-page-total="true">4</span></footer></section><section data-bid-form-page="3" class="bid-page"><h2>Bid Form Section 2: Bidder Information and Terms</h2><table><tbody><tr><th>Firm name</th><td><span class="write-in"></span></td></tr><tr><th>Address</th><td><span class="write-in"></span></td></tr><tr><th>Contact person, phone and email</th><td><span class="write-in"></span></td></tr><tr><th>License and registration numbers</th><td><span class="write-in"></span></td></tr><tr><th>Addenda acknowledged (list numbers)</th><td><span class="write-in"></span></td></tr><tr><th>Claim resident preference?</th><td>Yes <span class="write-in"></span> No <span class="write-in"></span></td></tr></tbody></table><section data-clause="bid_form_terms"><h3>Bid Terms</h3><p>The undersigned bidder offers to perform all of the work for this project, as described in the plans, specifications and addenda, for the total price shown in Section 1, and agrees to complete the work within the time stated in the contract.</p><p>The bidder confirms that it has examined the site and this solicitation, that it has acknowledged every addendum, and that its price includes all labor, materials, equipment, taxes, insurance, bonds and other costs needed to do the work.</p><p>The bid stays open for acceptance for 90 days after the bid due date. If the bidder is awarded the contract, it will sign the contract and provide the required insurance and any required bonds within the time stated in the notice of award.</p></section><footer data-footer="final" data-footer-template="Solicitation 27-0001 · Version 1 · Page {n} of {total}">Solicitation 27-0001 · Version 1 · Page <span data-page-n="true">3</span> of <span data-page-total="true">4</span></footer></section><section data-bid-form-page="4" class="bid-page"><h2>Signature Page</h2><section data-clause="signature_certifications"><h3>Signature and Certifications</h3><p>By signing, the person named below, who is authorized to bind the bidder, certifies on the bidder&#x27;s behalf that:</p><p>(a) the bid was prepared on its own, without any agreement or understanding with another bidder about prices or about whether to bid;</p><p>(b) the bidder has not offered or given a gift or favor to any public employee in connection with this solicitation;</p><p>(c) the bidder is not barred from public contracts in the State of Calder or suspended from them;</p><p>(d) everything stated in the bid is true and complete; and</p><p>(e) the bidder has read and agrees to every term of Solicitation 27-0001.</p><p>A false statement may lead to rejection of the bid, cancellation of any contract awarded, and the other remedies the law allows.</p></section><div class="sig-line"></div><p>Authorized signature</p><p>Printed name and title: <span class="write-in"></span></p><p>Date: <span class="write-in"></span></p><footer data-footer="final" data-footer-template="Solicitation 27-0001 · Version 1 · Page {n} of {total}">Solicitation 27-0001 · Version 1 · Page <span data-page-n="true">4</span> of <span data-page-total="true">4</span></footer></section></body></html>"
`;

exports[`bid form fill > without a fill the output is unchanged from slice 1 2`] = `
"<!doctype html><html lang="en"><head><meta charSet="utf-8"/><title>Bid Form (draft)</title><style>
@page { size: letter; margin: 0.9in 0.8in 1in 0.8in; }
* { box-sizing: border-box; }
body { font-family: Georgia, "Times New Roman", serif; font-size: 11pt; line-height: 1.4; color: #111; margin: 0; }
h1 { font-size: 22pt; margin: 0 0 12pt; }
h2 { font-size: 15pt; margin: 0 0 8pt; border-bottom: 1px solid #444; padding-bottom: 3pt; }
h3 { font-size: 12pt; margin: 12pt 0 4pt; }
p { margin: 0 0 8pt; }
table { border-collapse: collapse; width: 100%; margin: 6pt 0 12pt; }
th, td { border: 1px solid #555; padding: 4pt 6pt; text-align: left; vertical-align: top; }
th { background: #eee; }
.major { page-break-before: always; }
